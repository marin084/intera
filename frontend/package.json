{
  "name": "frontend",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.loader.config.ts && node -e \"const fs=require('fs'); if(fs.existsSync('dist/widget.html')){ fs.mkdirSync('dist/widget', {recursive:true}); fs.copyFileSync('dist/widget.html', 'dist/widget/index.html'); } if(fs.existsSync('dist/widget/script.js')){ fs.copyFileSync('dist/widget/script.js', 'dist/widget/conexa.js'); }\"",
    "build:webchat": "tsc -b && vite build --config vite.loader.config.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep smoke",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "laravel-echo": "^2.5.0",
    "lucide-react": "^1.51.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
