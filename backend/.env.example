# ==============================================================================
# INTERA — Variables de Entorno y Configuración
# ==============================================================================

# Entorno de la Aplicación
APP_NAME=Intera
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# URL del Frontend Web
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Tiempos de espera para alertas de Discord y consultas de vigencia de Meta.
DISCORD_ALERT_TIMEOUT_SECONDS=5
META_TOKEN_CHECK_TIMEOUT_SECONDS=10
META_TOKEN_ALERT_TIMEZONE=America/Costa_Rica

# Base de Datos (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=intera
DB_USERNAME=intera
DB_PASSWORD=your_secure_db_password_here

# Redis (Caché, Rate Limiting, Colas y Sesiones)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Inicialización Automática del Primer Administrador (Opcional)
# Si se configuran, el comando de inicialización de administrador las tomará por defecto.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# Tuning de Alta Concurrencia y Timeouts de Base de Datos
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=10000
PHP_FPM_MAX_CHILDREN=40
PHP_FPM_START_SERVERS=10
PHP_FPM_MIN_SPARE_SERVERS=8
PHP_FPM_MAX_SPARE_SERVERS=20
PHP_FPM_MAX_REQUESTS=1000
WEBCHAT_RATE_LIMIT_SESSION=120
WEBCHAT_RATE_LIMIT_MESSAGES=120
WEBCHAT_RATE_LIMIT_EMBED=120
