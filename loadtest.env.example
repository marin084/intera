# Synthetic credentials used only by docker-compose.loadtest.yml.
# scripts/loadtest-webchat.sh init creates loadtest.env with a random APP_KEY and DB password.
APP_NAME=Conexa Load Test
APP_ENV=loadtest
APP_KEY=GENERATED_BY_INIT
APP_DEBUG=false
APP_URL=http://localhost:18080
LOG_CHANNEL=stderr
LOG_LEVEL=warning

LOADTEST_DB_PASSWORD=GENERATED_BY_INIT

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=conexa_loadtest
DB_USERNAME=conexa_loadtest

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
CACHE_PREFIX=conexa_loadtest_
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=conexa-loadtest
REVERB_APP_KEY=conexa-loadtest-key
REVERB_APP_SECRET=conexa-loadtest-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

WEBCHAT_RATE_LIMIT_SESSION=5000
WEBCHAT_RATE_LIMIT_MESSAGES=5000
WEBCHAT_RATE_LIMIT_EMBED=5000
PHP_FPM_MAX_CHILDREN=12
PHP_FPM_START_SERVERS=6
PHP_FPM_MIN_SPARE_SERVERS=3
PHP_FPM_MAX_SPARE_SERVERS=6
